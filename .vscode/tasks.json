{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JSLABS: servidor local",
      "type": "process",
      "command": "pnpm",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "jslabs",
        "pattern": {
          "regexp": "^(?!.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "node scripts/astro.mjs dev",
          "endsPattern": "Dev server running at"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
