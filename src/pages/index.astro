---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterDemo from '../components/BeforeAfterDemo.astro';

const title = 'E-commerce Growth & Conversion | North/Shop';
const description =
  'North/Shop helps e-commerce brands find and fix customer-experience, conversion and performance problems.';
const services = [
  [
    'Conversion strategy',
    'Estrategia de conversión',
    'Find where shoppers hesitate or abandon and prioritize the changes with the greatest business impact.',
    'Detectamos dónde los compradores dudan o abandonan y priorizamos los cambios de mayor impacto.',
  ],
  [
    'Storefront experience',
    'Experiencia de tienda',
    'Improve product discovery, product pages, mobile journeys and checkout paths on your current platform.',
    'Mejoramos el descubrimiento, las páginas de producto, la experiencia móvil y el camino al checkout en tu plataforma actual.',
  ],
  [
    'Performance & measurement',
    'Rendimiento y medición',
    'Reduce avoidable speed issues and measure the events that matter so decisions are based on evidence.',
    'Reducimos problemas evitables de velocidad y medimos lo importante para tomar decisiones con evidencia.',
  ],
];
const process = [
  [
    'Request your review',
    'Solicita tu revisión',
    'Share your store, goals and current challenges. We review the context before recommending any engagement.',
    'Comparte tu tienda, objetivos y retos. Revisamos el contexto antes de recomendar cualquier servicio.',
  ],
  [
    'Get a clear diagnosis',
    'Recibe un diagnóstico claro',
    'We identify the main opportunities, explain the friction and define what should happen first.',
    'Identificamos las oportunidades, explicamos la fricción y definimos qué debe suceder primero.',
  ],
  [
    'Agree on scope',
    'Acordamos el alcance',
    'You receive a tailored scope, timeline and investment based on your platform and priorities.',
    'Recibes un alcance, plazo e inversión personalizados según tu plataforma y prioridades.',
  ],
  [
    'Improve, test, hand off',
    'Mejoramos, probamos y entregamos',
    'We implement safely, test the customer journey and document every change before launch.',
    'Implementamos de forma segura, probamos la experiencia y documentamos cada cambio antes de publicar.',
  ],
];
const faqs = [
  [
    'Which platforms do you work with?',
    '¿Con qué plataformas trabajan?',
    'We are platform-agnostic. The review confirms whether your stack fits our implementation capabilities or needs an additional specialist.',
    'Trabajamos sin depender de una plataforma. La revisión confirma si tu stack encaja con nuestras capacidades o necesita otro especialista.',
  ],
  [
    'How much does a project cost?',
    '¿Cuánto cuesta un proyecto?',
    'There is no fixed package price. Investment depends on the problems, outcomes, platform and technical complexity. You receive a clear proposal after the review.',
    'No hay un precio fijo. La inversión depende de los problemas, resultados, plataforma y complejidad técnica. Recibes una propuesta clara después de la revisión.',
  ],
  [
    'Do you guarantee conversion growth?',
    '¿Garantizan un aumento de conversión?',
    'No responsible partner can guarantee a percentage. We reduce observable friction and create a clearer measurement foundation.',
    'Ningún socio responsable puede garantizar un porcentaje. Reducimos fricción observable y dejamos una base de medición más clara.',
  ],
];
---

<BaseLayout {title} {description} schema="service">
  <main>
    <section class="relative overflow-hidden border-b-2 border-black pt-28 pb-16 md:pt-40 md:pb-24">
      <div class="blob absolute -right-24 top-24 h-72 w-72 rounded-full bg-[var(--lime)]" aria-hidden="true"></div>
      <div
        class="relative mx-auto grid max-w-[1400px] grid-cols-[minmax(0,1fr)] gap-14 px-5 md:px-10 xl:grid-cols-[minmax(0,1fr)_minmax(34rem,.92fr)] xl:items-center"
      >
        <div>
          <span
            class="tag"
            data-en="E-commerce growth · strategy + implementation"
            data-es="Crecimiento e-commerce · estrategia + implementación"
            >E-commerce growth · strategy + implementation</span
          >
          <h1 class="hero-title display mt-7 max-w-5xl text-[15vw] leading-[.83] sm:text-[11vw] xl:text-[6.2rem]">
            <span class="block" data-en="Turn more visits into" data-es="Convierte más visitas en"
              >Turn more visits into</span
            >
            <span class="block text-[var(--pop)]" data-en="confident purchases." data-es="compras con confianza."
              >confident purchases.</span
            >
          </h1>
          <p
            class="mt-8 max-w-3xl text-lg leading-relaxed md:text-2xl"
            data-en="North/Shop helps e-commerce brands identify what is blocking growth, improve the customer journey and implement the right changes—without forcing every business into the same package."
            data-es="North/Shop ayuda a marcas e-commerce a identificar qué frena su crecimiento, mejorar la experiencia de compra e implementar los cambios correctos, sin forzar a todos al mismo paquete."
          >
            North/Shop helps e-commerce brands identify what is blocking growth, improve the customer journey and
            implement the right changes—without forcing every business into the same package.
          </p>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a
              href="#contact"
              class="btn-primary px-7 py-4 text-center text-sm font-bold uppercase tracking-wider"
              data-en="Request a tailored review →"
              data-es="Solicita una revisión personalizada →">Request a tailored review →</a
            ><a
              href="#process"
              class="btn-outline px-7 py-4 text-center text-sm font-bold uppercase tracking-wider"
              data-en="See how we work ↓"
              data-es="Conoce el proceso ↓">See how we work ↓</a
            >
          </div>
          <p
            class="mono mt-5 text-xs uppercase tracking-wider opacity-65"
            data-en="Platform-agnostic · Scope based on your needs · No fixed pricing"
            data-es="Sin depender de una plataforma · Alcance según tus necesidades · Sin precios fijos"
          >
            Platform-agnostic · Scope based on your needs · No fixed pricing
          </p>
        </div>
        <BeforeAfterDemo />
      </div>
    </section>

    <section id="services" class="border-b-2 border-black bg-white py-20 md:py-28">
      <div class="mx-auto max-w-[1400px] px-5 md:px-10">
        <span class="tag" data-en="How we help" data-es="Cómo te ayudamos">How we help</span>
        <h2
          class="display mt-5 max-w-5xl text-6xl md:text-8xl"
          data-en="A better buying experience, built around your real bottlenecks."
          data-es="Una mejor experiencia de compra, enfocada en tus obstáculos reales."
        >
          A better buying experience, built around your real bottlenecks.
        </h2>
        <div class="mt-14 grid gap-6 lg:grid-cols-3">
          {
            services.map((s, i) => (
              <article class="card-hover border-2 border-black bg-[var(--bone)] p-7">
                <>
                  <span class="mono font-bold text-[var(--pop)]">0{i + 1}</span>
                  <h3 class="display mt-10 text-3xl" data-en={s[0]} data-es={s[1]}>
                    {s[0]}
                  </h3>
                  <p class="mt-5 leading-relaxed opacity-80" data-en={s[2]} data-es={s[3]}>
                    {s[2]}
                  </p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="process" class="border-b-2 border-black py-20 md:py-28">
      <div class="mx-auto max-w-[1400px] px-5 md:px-10">
        <span class="tag" data-en="A simple, visible workflow" data-es="Un flujo simple y visible"
          >A simple, visible workflow</span
        >
        <h2
          class="display mt-5 max-w-5xl text-6xl md:text-8xl"
          data-en="You always know what happens next."
          data-es="Siempre sabes cuál es el siguiente paso."
        >
          You always know what happens next.
        </h2>
        <p
          class="mt-7 max-w-3xl text-lg leading-relaxed"
          data-en="We begin with diagnosis, not a predetermined sale. Your review gives us the context to recommend the right scope, timeline and investment."
          data-es="Comenzamos con un diagnóstico, no con una venta predeterminada. Tu revisión nos da el contexto para recomendar el alcance, plazo e inversión correctos."
        >
          We begin with diagnosis, not a predetermined sale. Your review gives us the context to recommend the right
          scope, timeline and investment.
        </p>
        <div class="mt-14 grid border-l-2 border-t-2 border-black md:grid-cols-2 lg:grid-cols-4">
          {
            process.map((s, i) => (
              <article class="border-r-2 border-b-2 border-black p-6 md:p-8">
                <>
                  <span class="display text-5xl text-[var(--pop)]">0{i + 1}</span>
                  <h3 class="mt-8 text-xl font-bold" data-en={s[0]} data-es={s[1]}>
                    {s[0]}
                  </h3>
                  <p class="mt-4 leading-relaxed opacity-75" data-en={s[2]} data-es={s[3]}>
                    {s[2]}
                  </p>
                </>
              </article>
            ))
          }
        </div>
        <div
          class="mt-8 border-2 border-black bg-[var(--lime)] p-5 font-semibold md:p-7"
          data-en="Before work starts, you receive the goals, deliverables, responsibilities, timeline and investment in writing. Nothing goes live without your approval."
          data-es="Antes de comenzar, recibes por escrito objetivos, entregables, responsabilidades, plazos e inversión. Nada se publica sin tu aprobación."
        >
          Before work starts, you receive the goals, deliverables, responsibilities, timeline and investment in writing.
          Nothing goes live without your approval.
        </div>
      </div>
    </section>

    <section class="border-b-2 border-black bg-[var(--lime)] py-16 md:py-20">
      <div class="mx-auto grid max-w-[1400px] gap-8 px-5 md:px-10 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p
            class="mono text-xs font-bold uppercase tracking-widest"
            data-en="Scope and investment"
            data-es="Alcance e inversión"
          >
            Scope and investment
          </p><h2
            class="display mt-4 max-w-4xl text-5xl md:text-7xl"
            data-en="A proposal built for your store—not a price pulled from a template."
            data-es="Una propuesta creada para tu tienda, no un precio sacado de una plantilla."
          >
            A proposal built for your store—not a price pulled from a template.
          </h2><p
            class="mt-5 max-w-3xl"
            data-en="Your recommendation reflects your platform, customer journey, business priority, technical risk and the work required for a responsible result."
            data-es="La recomendación considera tu plataforma, experiencia del cliente, prioridad, riesgo técnico y el trabajo necesario para un resultado responsable."
          >
            Your recommendation reflects your platform, customer journey, business priority, technical risk and the work
            required for a responsible result.
          </p>
        </div><a
          href="#contact"
          class="bg-[var(--ink)] px-8 py-5 text-center text-sm font-bold uppercase tracking-wider text-[var(--bone)]"
          data-en="Get my review →"
          data-es="Solicitar mi revisión →">Get my review →</a
        >
      </div>
    </section>

    <section id="faq" class="border-b-2 border-black py-20 md:py-28">
      <div class="mx-auto grid max-w-[1400px] gap-12 px-5 md:px-10 lg:grid-cols-[.65fr_1fr] lg:gap-24">
        <div>
          <span class="tag">FAQ</span><h2
            class="display mt-5 text-6xl md:text-8xl"
            data-en="Clear before we start."
            data-es="Todo claro antes de empezar."
          >
            Clear before we start.
          </h2>
        </div><div class="border-t-2 border-black">
          {
            faqs.map((f) => (
              <details class="group border-b-2 border-black">
                <>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-bold">
                    <>
                      <span data-en={f[0]} data-es={f[1]}>
                        {f[0]}
                      </span>
                      <span class="plus text-2xl text-[var(--pop)]">+</span>
                    </>
                  </summary>
                  <p class="pb-7 pr-10 leading-relaxed opacity-75" data-en={f[2]} data-es={f[3]}>
                    {f[2]}
                  </p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" class="bg-[var(--ink)] py-20 text-[var(--bone)] md:py-28">
      <div class="mx-auto grid max-w-[1400px] gap-14 px-5 md:px-10 lg:grid-cols-[.9fr_1.1fr] lg:gap-24">
        <div>
          <span
            class="tag tag-lime"
            data-en="Start with a tailored review"
            data-es="Empieza con una revisión personalizada">Start with a tailored review</span
          ><h2
            class="display mt-5 text-6xl md:text-8xl"
            data-en="Tell us what growth looks like for you."
            data-es="Cuéntanos qué significa crecer para ti."
          >
            Tell us what growth looks like for you.
          </h2><p
            class="mt-7 max-w-xl text-lg leading-relaxed opacity-80"
            data-en="Share your store and the challenge you want to solve. We will respond with an initial perspective and the most sensible next step."
            data-es="Comparte tu tienda y el reto que quieres resolver. Responderemos con una primera perspectiva y el siguiente paso más sensato."
          >
            Share your store and the challenge you want to solve. We will respond with an initial perspective and the
            most sensible next step.
          </p>
        </div>
        <form id="store-review-form" class="dark-form relative space-y-5" action="/api/contact" method="post">
          <input type="hidden" name="submissionId" value="" /><div class="form-honeypot" aria-hidden="true">
            <input name="website" tabindex="-1" />
          </div>
          <div>
            <label for="name" class="mono mb-2 block text-xs uppercase" data-en="Name" data-es="Nombre">Name</label
            ><input
              id="name"
              name="name"
              required
              minlength="2"
              maxlength="100"
              autocomplete="name"
              class="border-[var(--bone)] text-[var(--bone)]"
            />
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label
                for="email"
                class="mono mb-2 block text-xs uppercase"
                data-en="Work email"
                data-es="Correo de trabajo">Work email</label
              ><input
                id="email"
                name="email"
                required
                type="email"
                autocomplete="email"
                class="border-[var(--bone)] text-[var(--bone)]"
              />
            </div><div>
              <label
                for="store"
                class="mono mb-2 block text-xs uppercase"
                data-en="Store URL"
                data-es="URL de la tienda">Store URL</label
              ><input
                id="store"
                name="store"
                required
                type="url"
                placeholder="https://"
                class="border-[var(--bone)] text-[var(--bone)]"
              />
            </div>
          </div>
          <div>
            <label
              for="goal"
              class="mono mb-2 block text-xs uppercase"
              data-en="What do you want to improve?"
              data-es="¿Qué quieres mejorar?">What do you want to improve?</label
            ><textarea
              id="goal"
              name="goal"
              required
              minlength="10"
              maxlength="2000"
              rows="5"
              class="border-[var(--bone)] text-[var(--bone)]"></textarea>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label
                for="priority"
                class="mono mb-2 block text-xs uppercase"
                data-en="Platform (optional)"
                data-es="Plataforma (opcional)">Platform (optional)</label
              ><input id="priority" name="priority" class="border-[var(--bone)] text-[var(--bone)]" />
            </div><div>
              <label
                for="deadline"
                class="mono mb-2 block text-xs uppercase"
                data-en="Desired timeline (optional)"
                data-es="Plazo deseado (opcional)">Desired timeline (optional)</label
              ><input id="deadline" name="deadline" class="border-[var(--bone)] text-[var(--bone)]" />
            </div>
          </div>
          <button
            type="submit"
            class="btn-invert w-full px-8 py-5 text-sm font-bold uppercase"
            data-en="Request my tailored review →"
            data-es="Solicitar mi revisión personalizada →">Request my tailored review →</button
          ><p id="form-status" class="mono text-xs uppercase text-[var(--lime)]" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <script>
    const form = document.querySelector<HTMLFormElement>('#store-review-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const sid = form?.elements.namedItem('submissionId') as HTMLInputElement | null;
    const lang = () => (document.documentElement.lang === 'es' ? 'es' : 'en');
    const msg = (en: string, es: string) => (lang() === 'es' ? es : en);
    const newId = () => {
      if (sid) sid.value = crypto.randomUUID();
    };
    newId();
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const original = button?.textContent ?? '';
      if (button) {
        button.disabled = true;
        button.textContent = msg('Sending…', 'Enviando…');
      }
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        if (!response.ok) throw new Error();
        form.reset();
        newId();
        if (status) {
          status.textContent = msg(
            'Request sent. We will reply shortly.',
            'Solicitud enviada. Te responderemos pronto.',
          );
          status.dataset.state = 'success';
        }
      } catch {
        if (status) {
          status.textContent = msg(
            'We could not send your request. Please try again.',
            'No pudimos enviar tu solicitud. Inténtalo de nuevo.',
          );
          status.dataset.state = 'error';
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = original;
        }
      }
    });
  </script>
</BaseLayout>

