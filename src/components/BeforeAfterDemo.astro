<script>
  const comparisonReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-comparison]').forEach((comparison) => {
    const frame = comparison.querySelector<HTMLElement>('[data-comparison-frame]');
    const range = comparison.querySelector<HTMLInputElement>('[data-comparison-range]');
    const toggle = comparison.querySelector<HTMLButtonElement>('[data-comparison-toggle]');
    if (!frame || !range || !toggle) return;

    let position = Number(range.value);
    let direction = 1;
    let manuallyPaused = false;
    let visible = true;
    let resumeAt = performance.now() + 1800;
    let previousFrame = performance.now();

    const render = (nextPosition: number) => {
      position = Math.min(Number(range.max), Math.max(Number(range.min), nextPosition));
      frame.style.setProperty('--comparison-position', `${position}%`);
      range.value = String(position);
      range.setAttribute('aria-valuetext', `${Math.round(position)}% before and ${Math.round(100 - position)}% after`);
    };

    const pauseAfterInteraction = () => {
      resumeAt = performance.now() + 6000;
      render(Number(range.value));
    };

    range.addEventListener('input', pauseAfterInteraction);
    range.addEventListener('pointerdown', pauseAfterInteraction);
    range.addEventListener('keydown', pauseAfterInteraction);

    toggle.addEventListener('click', () => {
      manuallyPaused = !manuallyPaused;
      toggle.setAttribute('aria-pressed', String(manuallyPaused));
      const spanish = document.documentElement.lang === 'es';
      toggle.textContent = manuallyPaused
        ? spanish
          ? 'Reanudar animación'
          : 'Play motion'
        : spanish
          ? 'Pausar animación'
          : 'Pause motion';
      if (!manuallyPaused) resumeAt = performance.now();
    });

    const visibilityObserver = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false;
        previousFrame = performance.now();
      },
      { threshold: 0.2 },
    );
    visibilityObserver.observe(comparison);

    const animate = (time: number) => {
      const elapsed = Math.min((time - previousFrame) / 1000, 0.1);
      previousFrame = time;

      if (visible && !document.hidden && !manuallyPaused && !comparisonReduceMotion.matches && time >= resumeAt) {
        position += direction * elapsed * 7;
        if (position >= 72) {
          position = 72;
          direction = -1;
        } else if (position <= 28) {
          position = 28;
          direction = 1;
        }
        render(position);
      }

      requestAnimationFrame(animate);
    };

    comparisonReduceMotion.addEventListener('change', () => {
      toggle.hidden = comparisonReduceMotion.matches;
      if (!comparisonReduceMotion.matches) resumeAt = performance.now() + 1800;
    });

    toggle.hidden = comparisonReduceMotion.matches;
    render(position);
    requestAnimationFrame(animate);
  });
</script>

