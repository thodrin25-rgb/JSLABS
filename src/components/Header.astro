<header class="fixed top-0 inset-x-0 z-50 border-b-2 border-black bg-[#f4f2ec]/90 backdrop-blur">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 h-16 md:h-20 flex items-center justify-between">
    <a href="/" class="flex items-center" aria-label="North Shop, home">
      <span class="brand-wordmark brand-wordmark--header" role="img" aria-label="North Shop">
        <img src="/brand/northshop-logo.svg" alt="" width="1536" height="1024" />
      </span>
      <span class="brand-mark" role="img" aria-label="North Shop">
        <img src="/brand/northshop-logo.svg" alt="" width="1536" height="1024" />
      </span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium" aria-label="Primary navigation">
      <a href="/#services" class="hover:text-[var(--pop)]" data-en="Services" data-es="Servicios">Services</a>
      <a href="/#process" class="hover:text-[var(--pop)]" data-en="How it works" data-es="Cómo trabajamos"
        >How it works</a
      >
      <a href="/#faq" class="hover:text-[var(--pop)]">FAQ</a>
    </nav>
    <div class="flex items-center gap-3">
      <a
        href="/#contact"
        class="btn-primary px-4 md:px-6 py-2.5 md:py-3 text-xs md:text-sm font-bold uppercase tracking-wider"
        ><span data-en="Request a review" data-es="Solicitar revisión">Request a review</span>
        <span aria-hidden="true">→</span></a
      >
      <div class="language-toggle" role="group" aria-label="Language selector">
        <button type="button" data-language="en" aria-pressed="true">EN</button>
        <button type="button" data-language="es" aria-pressed="false">ES</button>
      </div>
      <button
        id="menu-button"
        class="md:hidden btn-outline px-3 py-2 text-lg leading-none"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false">☰</button
      >
    </div>
  </div>
  <div id="mobile-menu" class="hidden md:hidden border-t-2 border-black bg-[var(--bone)]">
    <nav
      class="px-5 py-4 flex flex-col gap-3 text-sm font-bold uppercase tracking-wider"
      aria-label="Mobile navigation"
    >
      <a href="/#services" class="py-1" data-en="Services" data-es="Servicios">Services</a>
      <a href="/#process" class="py-1" data-en="How it works" data-es="Cómo trabajamos">How it works</a>
      <a href="/#faq" class="py-1">FAQ</a>
      <a href="/#contact" class="py-1 text-[var(--pop)]" data-en="Request a review" data-es="Solicitar revisión"
        >Request a review</a
      >
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
  });

  menu?.addEventListener('click', (event) => {
    if (!(event.target instanceof HTMLAnchorElement)) return;
    menu.classList.add('hidden');
    button?.setAttribute('aria-expanded', 'false');
  });
</script>

