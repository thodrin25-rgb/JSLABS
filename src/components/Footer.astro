---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--ink)] text-[var(--bone)] border-t-2 border-black">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-14">
    <span class="brand-wordmark brand-wordmark--footer" role="img" aria-label="North Shop">
      <img src="/brand/northshop-logo.svg" alt="" width="1536" height="1024" loading="lazy" />
    </span>
    <div class="mt-10 flex flex-wrap justify-between gap-8 items-end">
      <p class="mono text-xs uppercase tracking-widest opacity-70">
        © {year} North/Shop · Bolivia<br /><span
          data-en="E-commerce strategy and implementation for growing brands."
          data-es="Estrategia e implementación e-commerce para marcas en crecimiento."
          >E-commerce strategy and implementation for growing brands.</span
        >
      </p>
      <nav class="flex flex-wrap gap-6 text-sm font-medium" aria-label="Footer navigation">
        <a href="/#services" class="hover:text-[var(--lime)]" data-en="Services" data-es="Servicios">Services</a>
        <a href="/#process" class="hover:text-[var(--lime)]" data-en="Process" data-es="Proceso">Process</a>
        <a href="/#faq" class="hover:text-[var(--lime)]">FAQ</a>
        <a href="/#contact" class="hover:text-[var(--lime)]" data-en="Request a review" data-es="Solicitar revisión"
          >Request a review</a
        >
      </nav>
    </div>
  </div>
</footer>

