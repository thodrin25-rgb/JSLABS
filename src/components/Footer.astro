---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--ink)] text-[var(--bone)] border-t-2 border-black">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-14">
    <img
      src="/brand/northshop-wordmark.png"
      alt="North Shop"
      width="640"
      height="160"
      loading="lazy"
      class="h-auto w-full max-w-[640px] invert"
    />
    <div class="mt-10 flex flex-wrap justify-between gap-8 items-end">
      <p class="mono text-xs uppercase tracking-widest opacity-70">
        © {year} North/Shop Agency · Shopify Plus Partners<br />Built fast. Ships faster.
      </p>
      <nav class="flex flex-wrap gap-6 text-sm font-medium" aria-label="Footer navigation">
        <a href="/" class="hover:text-[var(--lime)]">Home</a>
        <a href="/promotions" class="hover:text-[var(--lime)]">Promotions</a>
        <a href="/launches" class="hover:text-[var(--lime)]">Launches</a>
        <a href="/#contact" class="hover:text-[var(--lime)]">Contact</a>
      </nav>
    </div>
  </div>
</footer>
