{
  "name": "north-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "node ./node_modules/lint-staged/bin/lint-staged.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{astro,css,js,mjs,json,md,yaml,yml}": "prettier --write"
  }
}
